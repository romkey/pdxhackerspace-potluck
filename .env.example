POTLUCK_TITLE="Summer Potluck"
POTLUCK_DATE="Saturday, July 12 - 5:00 PM"
POTLUCK_LOCATION="Maria's backyard, 14 Oak Lane"
POTLUCK_DESCRIPTION="Let us know you're coming and what kind of dish you'll bring. Family and friends welcome!"
POTLUCK_CATEGORIES="Meat,Vegetables,Carbs,Appetizers,Desserts,Drinks,Other"
POTLUCK_DB="/data/potluck.db"

