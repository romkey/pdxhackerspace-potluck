# Every environment variable this project uses, with dummy values. Copy to
# .env (gitignored) and fill in real values there; never in this file.
# docs/configuration.md says what each one does.

# --- The app ---------------------------------------------------------------

# PostgreSQL connection URL (required). In production compose the host is
# "db" and the credentials match POSTGRES_* below.
DATABASE_URL=postgresql://potluck:REPLACE_ME@db:5432/potluck

# Address to listen on. The Docker image sets 0.0.0.0; natively the
# default, 127.0.0.1, keeps the app private to this machine.
# HOST=127.0.0.1

# Port to listen on.
PORT=8080

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# --- The event -------------------------------------------------------------

POTLUCK_TITLE="Summer Potluck"
POTLUCK_DATE="Saturday, July 12 - 5:00 PM"
POTLUCK_LOCATION="Maria's backyard, 14 Oak Lane"
POTLUCK_DESCRIPTION="Let us know you're coming and what kind of dish you'll bring. Family and friends welcome!"
POTLUCK_CATEGORIES="Meat,Vegetables,Carbs,Appetizers,Desserts,Drinks,Other"
POTLUCK_EXAMPLE_NAME="Jack Hacksman"

# Directory searched for banner.png/.jpg/.jpeg/.webp/.gif when POTLUCK_BANNER
# is unset. The production compose file mounts ./data here as /data.
# POTLUCK_DATA_DIR=data

# Optional 1200x400 banner image: a file path or a URL.
# POTLUCK_BANNER="/data/banner.png"

# Optional GitHub repository URL. If unset, no footer link is shown.
# POTLUCK_GITHUB_REPO="https://github.com/your-name/potluck"

# --- The database container (production compose; not read by the app) -----

POSTGRES_USER=potluck
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=potluck

# --- Publishing to PyPI (optional; not read by the app) --------------------
# Only for publishing by hand from your machine (`uv publish`); releases
# from GitHub use trusted publishing or the PYPI_API_TOKEN repository
# secret instead; see
# https://github.com/romkey/python-ai-rules/blob/main/docs/releasing.md
# A project-scoped API token from https://pypi.org/manage/account/token/. Keep it out of
# .env on servers: compose passes .env to the app.
# UV_PUBLISH_TOKEN=pypi-REPLACE_ME
